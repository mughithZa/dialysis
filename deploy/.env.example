# Copy to deploy/.env and fill in. Never commit the real file.

# Public host name that points at this server (DNS A/AAAA record), e.g. dialysis.example.org
DOMAIN=
# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=
# Web-push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.org
# Time zone used for session dates and reminders
APP_TZ=Asia/Damascus
